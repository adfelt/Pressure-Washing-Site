      padding: 24px;
    }
    .calc-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .formula-block {
      padding: 16px;
    }
    .formula {
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }
