    color: var(--dark-gray);
  }

  /* Formula */
  .formula-block {
    background: var(--bg-light);
    border-left: 4px solid var(--primary-blue);
    border-radius: 8px;
    padding: 24px 32px;
    margin: 24px 0;
    display: flex;
    justify-content: center;
  }
  .formula {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: 'Montserrat', sans-serif;
  }
  .formula-label {
    font-weight: 700;
    color: var(--primary-blue);
    font-size: 15px;
  }
  .formula-eq {
    font-size: 24px;
    color: var(--light-gray);
  }
  .formula-fraction {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .numerator {
    border-bottom: 2px solid var(--dark-gray);
    padding-bottom: 4px;
    margin-bottom: 4px;
    font-weight: 600;
    font-size: 14px;
    color: var(--dark-gray);
  }
  .denominator {
    font-weight: 600;
    font-size: 14px;
    color: var(--dark-gray);
  }

  /* Target list */
  .target-list {
    padding-left: 20px;
    color: var(--light-gray);
    line-height: 2;
  }
  .target-list strong {
    color: var(--dark-gray);
  }

  /* Safety block */
  .safety-block {
    background: #FFF7ED;
    border-left: 4px solid #F59E0B;
    border-radius: 8px;
    padding: 20px 24px;
    margin-top: 32px;
  }
  .safety-block h3 {
    margin-top: 0;
    color: #92400E;
  }
  .safety-block ul {
    padding-left: 20px;
    color: #78350F;
    line-height: 2;
    margin: 0;
  }

  /* Calculator section */
  .calculator-section {
    padding: 60px 0;
    background: var(--bg-light);
  }

  .calc-card {
    background: var(--white);
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    padding: 40px;
    margin-top: 20px;
  }

  .calc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .calc-inputs h3,
  .calc-results h3 {
    font-family: 'Montserrat', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--dark-gray);
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--bg-light);
  }

  /* Input groups */
  .input-group {
    margin-bottom: 28px;
  }
  .input-group label {
    display: block;
    font-weight: 600;
    font-size: 14px;
    color: var(--dark-gray);
    margin-bottom: 8px;
  }
  .input-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .input-row input,
  .custom-ratio-wrap input {
    width: 100px;
    padding: 10px 14px;
    border: 2px solid #E5E7EB;
    border-radius: 8px;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    color: var(--dark-gray);
    transition: border-color 0.2s;
  }
  .input-row input:focus,
  .custom-ratio-wrap input:focus {
    outline: none;
    border-color: var(--primary-blue);
  }
  .input-unit {
    font-size: 14px;
    color: var(--light-gray);
    font-weight: 600;
  }
  .input-hint {
    font-size: 12px;
    color: var(--light-gray);
    margin-top: 6px;
    line-height: 1.5;
  }

  /* Ratio presets */
  .ratio-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
  }
  .ratio-btn {
    padding: 8px 16px;
    border: 2px solid #E5E7EB;
    border-radius: 8px;
    background: var(--white);
    color: var(--light-gray);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: all 0.2s;
  }
  .ratio-btn:hover {
    border-color: var(--primary-blue);
    color: var(--primary-blue);
  }
  .ratio-btn.active {
    border-color: var(--primary-blue);
    background: var(--primary-blue);
    color: var(--white);
  }

  .custom-ratio-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  /* Target presets */
  .target-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .target-btn {
    padding: 6px 12px;
    border: 2px solid #E5E7EB;
    border-radius: 8px;
    background: var(--white);
    color: var(--light-gray);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: all 0.2s;
  }
  .target-btn:hover {
    border-color: var(--primary-blue);
    color: var(--primary-blue);
  }
  .target-btn.active {
    border-color: var(--primary-blue);
    background: var(--primary-blue);
    color: var(--white);
  }

  /* Results */
  .result-block {
    background: var(--bg-light);
    border-radius: 12px;
    padding: 24px;
  }

  .result-surface {
    text-align: center;
    margin-bottom: 4px;
  }
  .result-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--light-gray);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }
  .result-value {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: var(--primary-blue);
    line-height: 1.1;
  }

  .result-divider {
    height: 1px;
    background: #E5E7EB;
    margin: 20px 0;
  }

  .result-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .result-item {
    text-align: center;
  }
  .result-item-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--light-gray);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }
