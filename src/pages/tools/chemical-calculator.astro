    font-family: 'Montserrat', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--dark-gray);
  }
  .result-item-sub {
    display: block;
    font-size: 12px;
    color: var(--light-gray);
    margin-top: 2px;
  }

  .result-warning {
    margin-top: 16px;
    background: #FEF2F2;
    border: 1px solid #FECACA;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 13px;
    color: #B91C1C;
    font-weight: 600;
    text-align: center;
  }

  .result-note {
    margin-top: 16px;
    font-size: 13px;
    color: var(--light-gray);
    line-height: 1.6;
  }

  /* FAQ */
  .faq-section {
    padding: 60px 0;
    background: var(--white);
  }
  .faq-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--dark-gray);
